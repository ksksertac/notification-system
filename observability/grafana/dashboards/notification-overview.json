{
  "title": "Notification Overview",
  "uid": "notification-overview",
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "channel",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(notifications_delivered_total, channel)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "title": "Summary",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Today - Delivered",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(notifications_delivered_total{channel=~\"$channel\"}[1d]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "Today",
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "This Week - Delivered",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(notifications_delivered_total{channel=~\"$channel\"}[7d]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "This Week",
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "This Month - Delivered",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(notifications_delivered_total{channel=~\"$channel\"}[30d]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "This Month",
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Today - Failed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(notifications_failed_total{channel=~\"$channel\"}[1d]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "Failed Today",
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Success Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(notifications_delivered_total{channel=~\"$channel\"}[1d])) / (sum(increase(notifications_delivered_total{channel=~\"$channel\"}[1d])) + sum(increase(notifications_failed_total{channel=~\"$channel\"}[1d]))) * 100",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "Success Rate",
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Avg Delivery Time",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(notification_delivery_duration_seconds_sum{channel=~\"$channel\"}[5m])) / sum(rate(notification_delivery_duration_seconds_count{channel=~\"$channel\"}[5m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "Avg Delivery",
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Delivery Throughput",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "title": "Deliveries / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(notifications_delivered_total{channel=~\"$channel\"}[1m])) by (channel) * 60",
          "legendFormat": "{{channel}} delivered"
        },
        {
          "expr": "sum(rate(notifications_failed_total{channel=~\"$channel\"}[1m])) by (channel) * 60",
          "legendFormat": "{{channel}} failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "drawStyle": "line",
            "showPoints": "never",
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*failed" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "title": "Delivery Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(notification_delivery_duration_seconds_bucket{channel=~\"$channel\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(notification_delivery_duration_seconds_bucket{channel=~\"$channel\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(notification_delivery_duration_seconds_bucket{channel=~\"$channel\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "drawStyle": "line",
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "title": "Channel Breakdown",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "title": "Delivered by Channel (Today)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(notifications_delivered_total[1d])) by (channel)",
          "legendFormat": "{{channel}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 }
      }
    },
    {
      "title": "Failure Rate by Channel",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(notifications_failed_total{channel=~\"$channel\"}[5m])) by (channel) / (sum(rate(notifications_delivered_total{channel=~\"$channel\"}[5m])) by (channel) + sum(rate(notifications_failed_total{channel=~\"$channel\"}[5m])) by (channel)) * 100",
          "legendFormat": "{{channel}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "drawStyle": "line",
            "showPoints": "never"
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          },
          "custom2": {}
        }
      }
    },
    {
      "title": "Avg Latency by Channel",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(notification_delivery_duration_seconds_sum{channel=~\"$channel\"}[1h])) by (channel) / sum(rate(notification_delivery_duration_seconds_count{channel=~\"$channel\"}[1h])) by (channel)",
          "legendFormat": "{{channel}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Protection",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "title": "Rate Limit Hits / min",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(rate_limit_hits_total[1m])) * 60",
          "legendFormat": "rate limit hits"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 25, "lineWidth": 2, "drawStyle": "line", "showPoints": "never" },
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "orange" }
        }
      }
    },
    {
      "title": "Circuit Breaker Opens / min",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(circuit_breaker_open_total[1m])) * 60",
          "legendFormat": "CB opens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 25, "lineWidth": 2, "drawStyle": "line", "showPoints": "never" },
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      }
    },
    {
      "title": "Cumulative Totals",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(notifications_delivered_total{channel=~\"$channel\"})",
          "legendFormat": "Delivered (all-time)"
        },
        {
          "expr": "sum(notifications_failed_total{channel=~\"$channel\"})",
          "legendFormat": "Failed (all-time)"
        },
        {
          "expr": "sum(rate_limit_hits_total)",
          "legendFormat": "Rate Limits (all-time)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      }
    }
  ]
}
